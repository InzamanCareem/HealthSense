<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="400.0" prefWidth="1000.0" styleClass="background" stylesheets="@../stylesheets/style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.healthsenseapp.controllers.BSTController">
   <padding>
      <Insets bottom="10" left="10" right="10" top="10" />
   </padding>
   <children>
      <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="49.0" prefWidth="979.0" spacing="10.0" VBox.vgrow="NEVER">
         <children>
            <Label prefWidth="236.0" text="View Order" textFill="WHITE">
               <font>
                  <Font name="Cambria Bold" size="20.0" />
               </font>
            </Label>
            <RadioButton fx:id="inOrderRadio" mnemonicParsing="false" text="Alphabetical (In-Order)" textFill="WHITE">
               <toggleGroup>
                  <ToggleGroup fx:id="traversalOrder" />
               </toggleGroup>
            </RadioButton>
            <RadioButton fx:id="preOrderRadio" mnemonicParsing="false" text="Analysis Order (Pre-Order)" textFill="WHITE" toggleGroup="$traversalOrder" />
            <RadioButton fx:id="postOrderRadio" mnemonicParsing="false" text="Processing Order (Post-Order)" textFill="WHITE" toggleGroup="$traversalOrder" />
            <Button mnemonicParsing="false" onAction="#viewResults" text="View Results" />
         </children>
      </VBox>
      <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="310.0" prefWidth="777.0" VBox.vgrow="ALWAYS">
         <VBox.margin>
            <Insets bottom="10.0" top="20.0" />
         </VBox.margin>
         <content>
            <VBox maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="104.0" prefWidth="978.0">
               <children>
                  <GridPane fx:id="diseaseClassificationGrid" prefHeight="112.0" prefWidth="978.0" stylesheets="@../stylesheets/style.css" VBox.vgrow="ALWAYS">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                     <VBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </VBox.margin>
                  </GridPane>
               </children></VBox>
         </content>
      </ScrollPane>
   </children>
</VBox>
